# Copia este fichero a ".env" y cambia los valores:  cp .env.example .env
PORT=3001

# Cadena larga y aleatoria (firma las sesiones de admin). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Único administrador
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contraseña
# Opcional (mejor en producción): hash en vez de contraseña en claro. Genera con: npm run hash -- "pass"
# ADMIN_PASSWORD_HASH=

# Ruta de la base de datos SQLite
DB_PATH=./data/torneo.db

# Opcional: dominios permitidos (coma). Vacío = cualquiera.
# CORS_ORIGIN=https://mi-torneo.com
